<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ArduinoIDEAndroid" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/arduino_primary</item>
        <item name="colorPrimaryDark">@color/arduino_primary_dark</item>
        <item name="colorOnPrimary">@color/arduino_on_primary</item>
        <item name="android:windowBackground">@color/arduino_surface</item>
        <item name="android:windowSplashScreenBackground">@color/arduino_primary</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/arduino_surface_titlebar</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/arduino_surface_statusbar</item>
        <item name="tabStyle">@style/ArduinoTabStyle</item>
    </style>

    <style name="ArduinoTabStyle" parent="Widget.Material3.TabLayout">
        <item name="tabBackground">@color/arduino_surface_tab_inactive</item>
        <item name="tabTextColor">@color/arduino_text_tab_inactive</item>
        <item name="tabSelectedTextColor">@color/arduino_text_tab_active</item>
        <item name="tabIndicatorColor">@color/arduino_primary</item>
        <item name="tabIndicatorFullWidth">true</item>
        <item name="tabIndicatorHeight">2dp</item>
    </style>

    <style name="ArduinoToolbarButton">
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">8dp</item>
        <item name="tint">@color/arduino_toolbar_icon</item>
    </style>

    <style name="ArduinoBoardSelector" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/arduino_board_selector_text</item>
        <item name="android:textSize">13sp</item>
        <item name="strokeColor">@color/arduino_border</item>
        <item name="cornerRadius">4dp</item>
    </style>

    <style name="ArduinoOutputText">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/arduino_output_text</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="ArduinoStatusBarText">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/arduino_on_primary</item>
    </style>
</resources>
