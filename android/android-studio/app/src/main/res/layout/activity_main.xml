<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/arduino_surface"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/main_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ======== TITLE BAR (Teal) ======== -->
        <LinearLayout
            android:id="@+id/title_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/arduino_surface_titlebar"
            android:gravity="center_vertical"
            android:minHeight="32dp"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/title_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/arduino_on_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Blink | Arduino IDE 2.3.7" />
        </LinearLayout>

        <!-- ======== MENU BAR ======== -->
        <HorizontalScrollView
            android:id="@+id/menu_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/arduino_surface_menubar"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/menu_file"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/menu_file"
                    android:textColor="@color/arduino_text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/menu_edit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/menu_edit"
                    android:textColor="@color/arduino_text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/menu_sketch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/menu_sketch"
                    android:textColor="@color/arduino_text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/menu_tools"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/menu_tools"
                    android:textColor="@color/arduino_text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/menu_help"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/menu_help"
                    android:textColor="@color/arduino_text_primary"
                    android:textSize="13sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- ======== TOOLBAR (Verify, Upload, Board Selector) ======== -->
        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height"
            android:background="@drawable/toolbar_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <!-- Verify button -->
            <ImageButton
                android:id="@+id/verify_button"
                android:layout_width="@dimen/toolbar_button_size"
                android:layout_height="@dimen/toolbar_button_size"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_verify"
                android:padding="@dimen/toolbar_icon_padding"
                android:src="@drawable/ic_verify"
                app:tint="@color/arduino_toolbar_icon" />

            <!-- Upload button -->
            <ImageButton
                android:id="@+id/upload_button"
                android:layout_width="@dimen/toolbar_button_size"
                android:layout_height="@dimen/toolbar_button_size"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_upload"
                android:padding="@dimen/toolbar_icon_padding"
                android:src="@drawable/ic_upload"
                app:tint="@color/arduino_toolbar_icon" />

            <!-- Debug button -->
            <ImageButton
                android:id="@+id/debug_button"
                android:layout_width="@dimen/toolbar_button_size"
                android:layout_height="@dimen/toolbar_button_size"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_debug"
                android:padding="@dimen/toolbar_icon_padding"
                android:src="@drawable/ic_debug"
                app:tint="@color/arduino_toolbar_icon" />

            <!-- Separator -->
            <View
                android:layout_width="@dimen/toolbar_separator_width"
                android:layout_height="24dp"
                android:layout_marginStart="@dimen/toolbar_separator_margin"
                android:layout_marginEnd="@dimen/toolbar_separator_margin"
                android:background="@drawable/toolbar_separator" />

            <!-- Board selector -->
            <LinearLayout
                android:id="@+id/board_selector"
                android:layout_width="0dp"
                android:layout_height="@dimen/board_selector_height"
                android:layout_weight="1"
                android:background="@drawable/board_selector_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/board_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/board_label"
                    android:textColor="@color/arduino_board_selector_text"
                    android:textSize="@dimen/board_selector_text_size" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@string/select_board"
                    android:src="@drawable/ic_dropdown_arrow"
                    app:tint="@color/arduino_toolbar_icon" />
            </LinearLayout>

            <!-- Separator -->
            <View
                android:layout_width="@dimen/toolbar_separator_width"
                android:layout_height="24dp"
                android:layout_marginStart="@dimen/toolbar_separator_margin"
                android:layout_marginEnd="@dimen/toolbar_separator_margin"
                android:background="@drawable/toolbar_separator" />

            <!-- Serial Monitor -->
            <ImageButton
                android:id="@+id/serial_monitor_button"
                android:layout_width="@dimen/toolbar_button_size"
                android:layout_height="@dimen/toolbar_button_size"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_serial_monitor"
                android:padding="@dimen/toolbar_icon_padding"
                android:src="@drawable/ic_serial_monitor"
                app:tint="@color/arduino_toolbar_icon" />

            <!-- Serial Plotter -->
            <ImageButton
                android:id="@+id/serial_plotter_button"
                android:layout_width="@dimen/toolbar_button_size"
                android:layout_height="@dimen/toolbar_button_size"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_serial_plotter"
                android:padding="@dimen/toolbar_icon_padding"
                android:src="@drawable/ic_serial_plotter"
                app:tint="@color/arduino_toolbar_icon" />

            <!-- More options -->
            <ImageButton
                android:id="@+id/more_options_button"
                android:layout_width="@dimen/toolbar_button_size"
                android:layout_height="@dimen/toolbar_button_size"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_more_options"
                android:padding="@dimen/toolbar_icon_padding"
                android:src="@drawable/ic_more_options"
                app:tint="@color/arduino_toolbar_icon" />
        </LinearLayout>

        <!-- Toolbar bottom border -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/arduino_border" />

        <!-- ======== MAIN CONTENT AREA (Sidebar + Editor + Output) ======== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- ======== LEFT SIDEBAR ======== -->
            <LinearLayout
                android:id="@+id/sidebar"
                android:layout_width="@dimen/sidebar_width"
                android:layout_height="match_parent"
                android:background="@drawable/sidebar_background"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="4dp">

                <!-- Sketchbook / File Explorer -->
                <ImageButton
                    android:id="@+id/sidebar_sketchbook"
                    android:layout_width="@dimen/sidebar_width"
                    android:layout_height="@dimen/sidebar_width"
                    android:background="@drawable/sidebar_active_indicator"
                    android:contentDescription="@string/sidebar_sketchbook"
                    android:padding="@dimen/sidebar_icon_padding"
                    android:src="@drawable/ic_sketchbook"
                    app:tint="@color/arduino_sidebar_icon_active" />

                <!-- Board Manager -->
                <ImageButton
                    android:id="@+id/sidebar_boards"
                    android:layout_width="@dimen/sidebar_width"
                    android:layout_height="@dimen/sidebar_width"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/sidebar_board_manager"
                    android:padding="@dimen/sidebar_icon_padding"
                    android:src="@drawable/ic_board_manager"
                    app:tint="@color/arduino_sidebar_icon" />

                <!-- Library Manager -->
                <ImageButton
                    android:id="@+id/sidebar_libraries"
                    android:layout_width="@dimen/sidebar_width"
                    android:layout_height="@dimen/sidebar_width"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/sidebar_library_manager"
                    android:padding="@dimen/sidebar_icon_padding"
                    android:src="@drawable/ic_library_manager"
                    app:tint="@color/arduino_sidebar_icon" />

                <!-- Debug -->
                <ImageButton
                    android:id="@+id/sidebar_debug"
                    android:layout_width="@dimen/sidebar_width"
                    android:layout_height="@dimen/sidebar_width"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/sidebar_debug"
                    android:padding="@dimen/sidebar_icon_padding"
                    android:src="@drawable/ic_debug"
                    app:tint="@color/arduino_sidebar_icon" />

                <!-- Search -->
                <ImageButton
                    android:id="@+id/sidebar_search"
                    android:layout_width="@dimen/sidebar_width"
                    android:layout_height="@dimen/sidebar_width"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/sidebar_search"
                    android:padding="@dimen/sidebar_icon_padding"
                    android:src="@drawable/ic_search"
                    app:tint="@color/arduino_sidebar_icon" />
            </LinearLayout>

            <!-- Sidebar right border -->
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/arduino_border" />

            <!-- ======== EDITOR AREA (Tabs + Code + Output) ======== -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Tab bar -->
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tab_row"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/tab_height"
                    android:background="@color/arduino_surface_tab_inactive"
                    app:tabBackground="@color/arduino_surface_tab_inactive"
                    app:tabGravity="start"
                    app:tabIndicatorColor="@color/arduino_primary"
                    app:tabIndicatorFullWidth="true"
                    app:tabIndicatorHeight="2dp"
                    app:tabMaxWidth="200dp"
                    app:tabMinWidth="80dp"
                    app:tabMode="scrollable"
                    app:tabPaddingEnd="0dp"
                    app:tabPaddingStart="0dp"
                    app:tabSelectedTextColor="@color/arduino_text_tab_active"
                    app:tabTextColor="@color/arduino_text_tab_inactive" />

                <!-- Tab bar bottom border -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/arduino_border" />

                <!-- Code editor (main content) -->
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/editor_pager"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@color/arduino_surface_editor"
                    android:contentDescription="@string/editor_tabs_content_description"
                    tools:listitem="@layout/item_editor_page" />

                <!-- ======== OUTPUT PANEL ======== -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/arduino_border" />

                <!-- Output header -->
                <LinearLayout
                    android:id="@+id/output_header"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/output_header_height"
                    android:background="@drawable/output_header_background"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/output_title"
                        android:textColor="@color/arduino_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/output_toggle"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/output_toggle"
                        android:src="@drawable/ic_more_options"
                        app:tint="@color/arduino_toolbar_icon" />
                </LinearLayout>

                <!-- Output content -->
                <ScrollView
                    android:id="@+id/output_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/output_panel_min_height"
                    android:background="@drawable/output_panel_background">

                    <TextView
                        android:id="@+id/output_log"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="2dp"
                        android:padding="8dp"
                        android:textColor="@color/arduino_output_text"
                        android:textSize="@dimen/output_text_size"
                        tools:text="Compiling sketch...\nUsing board 'arduino:avr:uno' from platform in folder: ...\nUsing core 'arduino' from platform in folder: ..." />
                </ScrollView>

                <!-- ======== FIND/REPLACE PANEL (initially hidden) ======== -->
                <LinearLayout
                    android:id="@+id/find_replace_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/arduino_surface_toolbar"
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/find_query_label">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/find_query"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/find_query_label"
                                android:imeOptions="actionNext"
                                android:inputType="text"
                                android:textSize="13sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:hint="@string/replace_with_label">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/replace_query"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/replace_with_label"
                                android:imeOptions="actionDone"
                                android:inputType="text"
                                android:textSize="13sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/regex_toggle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/regex_toggle"
                            android:text="@string/regex_toggle"
                            android:textSize="12sp" />

                        <Spinner
                            android:id="@+id/search_scope"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:contentDescription="@string/search_scope" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="end"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/find_next"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="@string/action_find_next"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/replace"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="4dp"
                            android:text="@string/action_replace"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/replace_all"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="4dp"
                            android:text="@string/action_replace_all"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ======== STATUS BAR (Teal) ======== -->
        <LinearLayout
            android:id="@+id/status_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/status_bar_height"
            android:background="@drawable/statusbar_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/status_line_col"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/arduino_on_primary"
                android:textSize="@dimen/status_text_size"
                tools:text="Ln 1, Col 1" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Board connection status -->
            <View
                android:id="@+id/status_indicator"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/status_indicator_connected" />

            <TextView
                android:id="@+id/status_board_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/arduino_on_primary"
                android:textSize="@dimen/status_text_size"
                tools:text="Arduino Yún on /dev/ttyACM0" />

            <ImageView
                android:id="@+id/status_notification"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="12dp"
                android:contentDescription="@string/action_more_options"
                android:src="@drawable/ic_notification"
                app:tint="@color/arduino_on_primary" />
        </LinearLayout>
    </LinearLayout>

    <!-- ======== SNIPPET BOTTOM SHEET ======== -->
    <FrameLayout
        android:id="@+id/snippet_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:behavior_peekHeight="0dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/snippet_compose_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
